# Copy to .env and fill in the keys you have. .env is gitignored.
# In GitHub Actions these come from repository secrets (see README).
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GLM_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
# GITHUB_TOKEN is provided automatically inside Actions; locally a PAT with models:read works.
GITHUB_TOKEN=
